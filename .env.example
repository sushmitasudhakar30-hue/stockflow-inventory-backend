PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/stockflow
# One or more allowed frontend origins, comma separated
CLIENT_URL=http://localhost:5173
# Secret used to sign login tokens. Use a long random value, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
# Password given to the demo accounts created by `npm run seed`
SEED_PASSWORD=Stockflow@123
